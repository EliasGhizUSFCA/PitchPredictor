PITCHIQ_DATABASE_URL=postgresql+psycopg://pitchiq:pitchiq@localhost:5432/pitchiq
# PITCHIQ_DEFAULT_PITCHER_ID=519242
# PITCHIQ_SEASONS=[2023,2024,2025,2026]
# PITCHIQ_TRAIN_SEASONS=[2023,2024]
# PITCHIQ_VALIDATION_SEASONS=[2025]
# PITCHIQ_TEST_SEASONS=[2026]
# Mode A playback: directory with licensed clips + manifest.csv (see pitchiq/video/providers/licensed_local.py)
# PITCHIQ_LICENSED_VIDEO_DIR=/path/to/licensed/clips
# Experiment tracking: optional MLflow mirror (Postgres stays the source of truth). Default store is
# sqlite:///backend/mlruns/mlflow.db; set ENABLED=false to turn it off.
# PITCHIQ_MLFLOW_ENABLED=true
# PITCHIQ_MLFLOW_TRACKING_URI=sqlite:////abs/path/to/mlflow.db
# PITCHIQ_MLFLOW_ARTIFACT_ROOT=/abs/path/to/mlflow-artifacts
